# ==========================================
# HireLens AI - Environment Configuration
# ==========================================

# Application
NEXT_PUBLIC_APP_NAME="HireLens AI"
NEXT_PUBLIC_APP_TAGLINE="See Your Resume Through a Recruiter's Eyes"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# AI Engine Configurations (Supports Gemini 1.5/2.0 & OpenAI GPT-4o)
# Note: Platform has built-in offline NLP fallback heuristics if no API keys are provided!
GEMINI_API_KEY=""
OPENAI_API_KEY=""
AI_DEFAULT_PROVIDER="gemini" # or "openai"

# Database Configuration (PostgreSQL / Prisma / Supabase)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hirelens_ai?schema=public"

# Authentication (Firebase Auth / Clerk / NextAuth)
NEXT_PUBLIC_AUTH_PROVIDER="clerk" # "clerk" | "firebase" | "demo"
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# Upload limits
NEXT_PUBLIC_MAX_FILE_SIZE_MB=10
